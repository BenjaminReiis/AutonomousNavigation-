<sdf version="1.6">

<world name="test_world">


<include>

<uri>

model://ground_plane

</uri>

</include>



<include>

<uri>

model://sun

</uri>

</include>



<model name="obstacle_box">


<pose>

3 0 0.5 0 0 0

</pose>


<link name="link">


<collision name="collision">


<geometry>

<box>

<size>

1 1 1

</size>

</box>

</geometry>


</collision>



<visual name="visual">


<geometry>

<box>

<size>

1 1 1

</size>

</box>

</geometry>


</visual>


</link>


</model>


</world>

</sdf>
